# ── Development (SQLite) ─────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# The app creates the schema automatically when this database is empty.
# Set to true to always create missing tables on startup via metadata.create_all.
CREATE_TABLES=true

# ── Production (Neon / PostgreSQL) ───────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
# Leave CREATE_TABLES=false in production and manage the schema with Alembic migrations.
# CREATE_TABLES=false

SHOP_WHATSAPP=2376XXXXXXXX

# Set to "false" to skip filling an empty products table with the 8 catalogue products on startup.
SEED_PRODUCTS=true

# Comma separated list of origins allowed by CORS. "*" allows everything.
CORS_ORIGINS=*

# Optional: create this first administrator on startup if no admin exists yet (e.g. on Render,
# where there is no shell). Remove ADMIN_PASSWORD once the account exists.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please
