# Copy to .env and adjust for local development.
# All values are optional; sensible defaults are defined in app/core/config.py.

# PostgreSQL connection string (async). Render/Neon may hand you a "postgres://"
# URL; the app rewrites the scheme to "postgresql+asyncpg://" automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/papeterie

# WhatsApp number used to build the order deep-link (international format, no "+").
SHOP_WHATSAPP=2376XXXXXXXX

# Set to "true" to let the app create tables on startup via metadata.create_all.
# Leave "false" in production and manage the schema with Alembic migrations.
CREATE_TABLES=false

# Comma separated list of origins allowed by CORS. "*" allows everything.
CORS_ORIGINS=*
