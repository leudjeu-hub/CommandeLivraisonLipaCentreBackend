# ── Development (SQLite) ─────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./dev.db
CREATE_TABLES=true

# ── Production (Neon / PostgreSQL) ───────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
# CREATE_TABLES=false

SHOP_WHATSAPP=2376XXXXXXXX

# Set to "true" to let the app create tables on startup via metadata.create_all.
# Leave "false" in production and manage the schema with Alembic migrations.
CREATE_TABLES=false

# Set to "false" to skip filling an empty products table with the 8 catalogue products on startup.
SEED_PRODUCTS=true

# Comma separated list of origins allowed by CORS. "*" allows everything.
CORS_ORIGINS=*
