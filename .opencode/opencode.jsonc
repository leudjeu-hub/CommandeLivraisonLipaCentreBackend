{
  "$schema": "https://opencode.ai/config.json",

  // Learning project on a private repo - never auto-publish a session.
  "share": "disabled",

  // "notify" instead of true: don't silently swap the model mid-session.
  "autoupdate": "notify",

  "permission": {
    // Order matters: opencode takes the LAST matching rule, so the broad
    // "allow" comes first and the destructive patterns narrow it down.
    "bash": {
      "*": "allow",

      // Irreversible / data-losing. Ask first.
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "Remove-Item *-Recurse*": "ask",
      "del /s *": "ask",
      "git push --force*": "ask",
      "git push -f *": "ask",
      "git reset --hard*": "ask",
      "git clean -*": "ask",
      "git checkout -- *": "ask",
      "git restore --staged*": "ask",
      // AGENTS.md: `docker compose down -v` wipes the volumes.
      "docker compose down -v*": "ask",
      "docker-compose down -v*": "ask",
      // Deletes the SQLite file; there are no migrations (AGENTS.md).
      "del *fastship.db*": "ask"
    }
  }
}